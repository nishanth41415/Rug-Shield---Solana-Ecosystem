# RugShield P2 — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to git (it's in .gitignore).

# ---------------------------------------------------------------------------
# Solana RPC — set for production (public default works but is rate-limited)
# ---------------------------------------------------------------------------
# Get a free key at: https://dev.helius.xyz  or  https://www.quicknode.com
#
# HTTPS endpoint (used for all RPC calls):
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY_HERE

# WebSocket endpoint (used by solana_listener.py for real-time mint detection):
SOLANA_WSS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY_HERE

# ---------------------------------------------------------------------------
# PostgreSQL — required for docker-compose and graph signal DB checks
# ---------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=rugshield
POSTGRES_DB=rugshield
POSTGRES_PASSWORD=change_me

# ---------------------------------------------------------------------------
# Social API keys — OPTIONAL (S17/S18 report UNAVAILABLE without these)
# S14–S16 need sufficient RPC tx history; otherwise they are UNAVAILABLE too.
# ---------------------------------------------------------------------------
# Twitter Developer Portal: https://developer.twitter.com
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# Telegram BotFather: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# ---------------------------------------------------------------------------
# Redis — only needed for consumer.py / solana_listener.py
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
